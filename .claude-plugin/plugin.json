{
  "name": "arm-law",
  "displayName": "ArmLaw",
  "version": "1.2.0",
  "description": "A research skill for Armenian law, bundled with ARLIS search and document retrieval tools.",
  "author": { "name": "MMinasyan", "url": "https://github.com/MMinasyan" },
  "homepage": "https://github.com/MMinasyan/arm-law",
  "repository": "https://github.com/MMinasyan/arm-law",
  "license": "MIT",
  "keywords": ["armenian-law", "legal-research", "arlis", "legislation", "case-law", "statutory-interpretation"],
  "mcpServers": {
    "arlis": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--python", ">=3.11", "--from", "${CLAUDE_PLUGIN_ROOT}", "arlis-mcp"]
    }
  },
  "hooks": "./claude-code/hooks.json"
}
